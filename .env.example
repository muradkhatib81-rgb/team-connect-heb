# Supabase (client + server)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (PWA system notifications — server-only private key)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Push dispatch hook (server-only — same value must be set in Supabase internal_push_config)
PUSH_DISPATCH_SECRET=

# Cron / public hooks (server-only). Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Recurring tasks also accept x-recurring-tasks-secret = RECURRING_TASKS_SECRET or PUSH_DISPATCH_SECRET.
CRON_SECRET=
RECURRING_TASKS_SECRET=

# AI providers (server-only — never expose to the browser)
# Create at https://aistudio.google.com/apikey — key must start with AIza...
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Stripe (server-only — never expose to the browser)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<your-domain>/api/public/hooks/stripe-webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs from Stripe Product catalog
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_ENTERPRISE=
# Public site URL for Checkout success/cancel (optional; falls back to request origin)
# APP_PUBLIC_URL=https://team-connect-heb.vercel.app
